@startuml
actor Utilisateur as User
participant "Vue\nConnexion" as View
participant "VueModel\nAuthentification" as AuthVM
participant "Repository\nAuth" as AuthRepo
participant "Utilisateur" as UserEntity
database "Base de données" as DB

User -> View : saisir(email, motDePasse)
View -> AuthVM : LoginCommand.Execute(email, motDePasse)
note right: VueModel gère état (isLoading=true)
AuthVM -> AuthRepo : ValiderCredentialsAsync(email, motDePasse)
AuthRepo -> DB : trouverParEmail(email)
DB --> AuthRepo : utilisateur?

alt Identifiants valides
    AuthRepo -> AuthRepo : verifierMotDePasse(motDePasse)
    AuthRepo -> AuthRepo : genererToken()
    AuthRepo -> DB : enregistrerSessionAsync(utilisateur, token)
    DB --> AuthRepo : confirmation
    AuthRepo --> AuthVM : token + role
    AuthVM -> AuthVM : UpdateUserRole(role)
    note right: VueModel met à jour état (isLoggedIn=true)
    AuthVM --> View : OnLoginSuccess(token, role)
    View --> User : naviguerDashboard()
else Identifiants invalides
    AuthRepo --> AuthVM : null (erreur)
    AuthVM -> AuthVM : SetError("Identifiants invalides")
    AuthVM --> View : OnLoginError(message)
    View --> User : afficher erreur
end
note right: isLoading=false
@enduml

