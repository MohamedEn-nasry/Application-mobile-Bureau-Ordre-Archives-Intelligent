@startuml
actor "Responsable" as Resp
participant "Vue\nStatutCourrier" as StatusView
participant "VueModel\nStatut" as StatusVM
participant "Repository\nCourrier" as CourrierRepo
participant "Repository\nNotification" as NotifRepo
database "Base de données" as DB

StatusView -> StatusVM : chargerCourrier(courrierId)
StatusVM -> CourrierRepo : getCourrierAsync(courrierId)
CourrierRepo -> DB : trouverCourrier(courrierId)
DB --> CourrierRepo : courrier + statutActuel
CourrierRepo --> StatusVM : courrierData
StatusVM --> StatusView : afficherFicheCourrier()

Resp -> StatusView : cliquer "Modifier statut"
StatusView -> StatusVM : UpdateStatusCommand(nouveauStatut, commentaire)

note right: VM valide localement + isLoading=true
StatusVM -> CourrierRepo : changerStatutAsync(courrierId, nouveauStatut, commentaire)

CourrierRepo -> DB : vérifierTransition(courrierId, nouveauStatut)
DB --> CourrierRepo : transitionValide

alt Transition valide
    CourrierRepo -> DB : sauvegarderAncienneValeur()
    CourrierRepo -> DB : mettreAJourStatut()
    DB --> CourrierRepo : confirmation
    CourrierRepo -> DB : ajouterHistorique()
    
    opt Notification requise
        CourrierRepo -> NotifRepo : créerNotification(courrierId, nouveauStatut)
        NotifRepo -> DB : insererNotification()
    end
    
    CourrierRepo --> StatusVM : succès
    StatusVM --> StatusView : confirmation + refresh
    StatusView --> Resp : "Statut mis à jour"
    note right: VM: isLoading=false, refresh state
else Transition invalide
    DB --> CourrierRepo : erreur
    CourrierRepo --> StatusVM : erreurTransition
    StatusVM --> StatusView : erreur
    StatusView --> Resp : "Transition non autorisée"
end
@enduml

