@startuml
participant "Service\nDéclencheur" as Trigger
participant "VueModel\nNotifications" as NotifVM
participant "Repository\nUtilisateur" as UserRepo
database "Base de données" as DB
participant "Canal\nEmail" as Email
participant "Canal\nSMS" as SMS
participant "Vue\nNotifications" as NotifView

Trigger -> NotifVM : DéclencherNotificationAsync(type, données)
note right: Background service via VM

alt Type notification
    case "NOUVEAU_COURRIER"
        NotifVM -> DB : obtenirDestinatairesParRoleAsync("Responsable")
    case "STATUT_MODIFIE"
        NotifVM -> DB : obtenirUtilisateursSuivantAsync(courrierId)
    case "ASSIGNATION"
        NotifVM -> DB : obtenirUtilisateurAssignéAsync(courrierId)
    case "RAPPEL"
        NotifVM -> DB : obtenirCourriersEnAttenteAsync()
end

DB --> NotifVM : listeDestinataires
NotifVM -> UserRepo : GetPreferencesBatchAsync(destinataires)
UserRepo --> NotifVM : preferences

loop Pour chaque destinataire
    NotifVM -> NotifVM : CréerNotification(destinataire, type, message)
    NotifVM -> DB : EnregistrerNotificationAsync(notification)
    DB --> NotifVM : notificationId
    
    alt Préférences
        |Email|
        NotifVM -> Email : EnvoyerAsync(email, sujet, message)
        Email --> NotifVM : status
        |SMS|
        NotifVM -> SMS : EnvoyerAsync(telephone, message)
        SMS --> NotifVM : status
        |In-app|
        NotifVM --> NotifView : AddNotification(notification)
        NotifView -> NotifView : UpdateBadge()
    end
end

NotifVM --> Trigger : notificationsEnvoyées
@enduml

