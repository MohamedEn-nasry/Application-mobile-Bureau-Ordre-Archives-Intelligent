@startuml
actor "Administrateur" as Admin
participant "Vue\nGestionUtilisateurs" as UserView
participant "VueModel\nUtilisateurs" as UserVM
participant "Repository\nUtilisateur" as UserRepo
participant "Repository\nAuth" as AuthRepo
database "Base de données" as DB

UserView -> UserVM : listerUtilisateursAsync()
UserVM -> UserRepo : getAllUtilisateurs()
UserRepo -> DB : SELECT * FROM utilisateurs
DB --> UserRepo : listeUtilisateurs
UserRepo --> UserVM : usersList
UserVM --> UserView : afficherTableau()
UserView --> Admin : visualiser liste

== Création ==
Admin -> UserView : "Ajouter utilisateur"
UserView -> UserVM : createUserCommand(nom, email, role)
note right: VM: validateForm()

UserVM -> UserRepo : creerUtilisateurAsync(data)
UserRepo -> DB : vérifierEmailUnique(email)

alt Email unique
    UserRepo -> UserRepo : encoderMotDePasse()
    UserRepo -> DB : insererUtilisateur()
    DB --> UserRepo : userId
    UserRepo -> DB : attribuerRolePermissions()
    UserRepo --> UserVM : succès
    UserVM --> UserView : "Utilisateur créé"
    UserView --> Admin : confirmation
else Duplicat
    DB --> UserRepo : erreur
    UserRepo --> UserVM : duplicateEmailError
    UserVM --> UserView : erreur
    UserView --> Admin : "Email déjà utilisé"
end

== Modification ==
Admin -> UserView : sélectionner + éditer
UserView -> UserVM : updateUserCommand(userId, changes)
UserVM -> UserRepo : modifierAsync(userId, changes)
UserRepo -> DB : UPDATE utilisateur SET ...
DB --> UserRepo : rowsAffected
UserRepo -> DB : updatePermissions()
UserRepo --> UserVM : succès
UserVM --> UserView : refreshList()
UserView --> Admin : "Modifié"

== Désactivation ==
Admin -> UserView : "Désactiver"
UserView -> UserVM : deactivateCommand(userId)
UserVM -> UserRepo : desactiverAsync(userId)
UserRepo -> DB : UPDATE actif = false
DB --> UserRepo : confirmation
UserRepo --> UserVM : succès
UserVM --> UserView : confirmation
UserView --> Admin : "Compte désactivé"

UserView -> UserVM : close()
@enduml

