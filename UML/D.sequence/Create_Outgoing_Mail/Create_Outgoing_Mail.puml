@startuml
actor "Agent Administratif" as Agent
participant "Vue\nCourrierSortant" as OutMailView
participant "VueModel\nCourrierSortant" as OutMailVM
participant "Repository\nCourrier" as CourrierRepo
participant "Repository\nDocument" as DocRepo
database "Base de données" as DB

Agent -> OutMailView : cliquer "Nouveau courrier sortant"
OutMailView -> OutMailVM : initForm()
OutMailVM --> OutMailView : afficherFormulaire()

Agent -> OutMailView : saisir(destinataire, objet, contenu, priorite)
note right: VM binds form data

opt Joindre document
    Agent -> OutMailView : sélectionner fichier
    OutMailView -> OutMailVM : uploadDocument(fichier)
    note right: VM: isUploading=true
    OutMailVM -> DocRepo : uploadDocumentAsync(fichier)
    DocRepo -> DB : enregistrerDocument()
    DB --> DocRepo : documentId
    DocRepo --> OutMailVM : documentId
    OutMailVM --> OutMailView : fichier joint
end

Agent -> OutMailView : valider
OutMailView -> OutMailVM : createOutgoingCommand(data, docId?)

OutMailVM -> CourrierRepo : creerCourrierSortantAsync(data)
note right: VM: isLoading=true, validate data
CourrierRepo -> DB : insererCourrierSortant()
DB --> CourrierRepo : courrierId + numero
CourrierRepo -> DB : ajouterHistorique("Création")

opt Accusé
    CourrierRepo -> DB : genererAccuse(courrierId)
end

CourrierRepo --> OutMailVM : succès + numero
OutMailVM --> OutMailView : confirmation + numero
OutMailView --> Agent : "Courrier sortant #numero enregistré"
note right: VM: resetForm(), isLoading=false
@enduml

