' ============================================================
'  Code unique regroupant tous les cas :
'  Diagramme de cas d'utilisation + Diagrammes de séquence
'  avec intégration du rôle SuperAgent
' ============================================================

' ============================================================
' 1. DIAGRAMME DE CAS D'UTILISATION GÉNÉRAL
' ============================================================

@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam rectangle {
    BackgroundColor White
    BorderColor DarkSlateGray
}

actor "Lecteur" as Lecteur
actor "Agent" as Agent
actor "SuperAgent" as SuperAgent
actor "Administrateur" as Admin

Lecteur -down-|> Agent : "Hérite de"
Agent -down-|> SuperAgent : "Hérite de"
SuperAgent -up-|> Admin : "Hérite de"

rectangle "Système de Gestion de Courriers" {
  
  package "Authentification & Utilisateurs" {
    usecase "S'authentifier" as UC_AUTH
    usecase "Gérer les utilisateurs et rôles" as UC_ADMIN_USERS
  }
  
  package "Gestion des Courriers Entrants" {
    usecase "Gérer les courriers entrants" as UC_ENTRANT
    usecase "Scanner un document" as UC_SCAN
    usecase "Effectuer l'OCR" as UC_OCR
    usecase "Classer par IA/Règles" as UC_CLASSIF
    usecase "Ajouter pièces jointes" as UC_JOINTS
    usecase "Générer accusé de réception" as UC_ACCUSE
    usecase "Réassigner un courrier" as UC_REASSIGN
  }
  
  package "Gestion des Courriers Sortants" {
    usecase "Gérer les courriers sortants" as UC_SORTANT
    usecase "Mettre à jour le statut" as UC_STATUS
  }

  package "Recherche & Consultation" {
    usecase "Rechercher / Filtrer" as UC_SEARCH
    usecase "Suivre le statut & Historique" as UC_HISTORY
    usecase "Consulter par catégorie" as UC_CATEGORY
  }

  package "Notifications" {
    usecase "Recevoir des notifications" as UC_NOTIFY
  }

  package "Tableau de Bord" {
    usecase "Consulter le tableau de bord Lecteur" as UC_DASHBOARD
  }

  UC_ENTRANT ..> UC_AUTH : <<include>>
  UC_SORTANT ..> UC_AUTH : <<include>>
  UC_SEARCH ..> UC_AUTH : <<include>>
  UC_ADMIN_USERS ..> UC_AUTH : <<include>>
  
  UC_ENTRANT ..> UC_SCAN : <<include>>
  UC_SCAN ..> UC_OCR : <<include>>
  UC_ENTRANT ..> UC_CLASSIF : <<include>>
  UC_ENTRANT ..> UC_JOINTS : <<include>>
  UC_SORTANT ..> UC_JOINTS : <<include>>
  
  UC_HISTORY ..> UC_AUTH : <<include>>

  UC_STATUS <.. UC_NOTIFY : <<extend>>
  UC_ENTRANT <.. UC_NOTIFY : <<extend>>
  UC_ENTRANT <.. UC_ACCUSE : <<extend>>
  UC_STATUS <.. UC_HISTORY : <<extend>>
  UC_REASSIGN ..> UC_ENTRANT : <<include>>
  UC_CATEGORY ..> UC_SEARCH : <<include>>
}

Agent --> UC_ENTRANT
Agent --> UC_SORTANT
Agent --> UC_SEARCH
Agent --> UC_STATUS
Agent --> UC_HISTORY

SuperAgent --> UC_ENTRANT
SuperAgent --> UC_SORTANT
SuperAgent --> UC_SEARCH
SuperAgent --> UC_STATUS
SuperAgent --> UC_HISTORY
SuperAgent --> UC_NOTIFY
SuperAgent --> UC_REASSIGN
SuperAgent --> UC_CATEGORY
SuperAgent --> UC_DASHBOARD

Admin --> UC_ADMIN_USERS
Admin --> UC_SEARCH
Admin --> UC_STATUS
Admin --> UC_NOTIFY
Admin --> UC_HISTORY

Lecteur --> UC_SEARCH
Lecteur --> UC_HISTORY
Lecteur --> UC_NOTIFY
@enduml


' ============================================================
' 2. DIAGRAMME DE SÉQUENCE - Connexion
' ============================================================

@startuml
title Connexion utilisateur

actor "Utilisateur (tous rôles)" as User
participant "Interface" as UI
participant "AuthService" as Auth
participant "Session" as Session

User -> UI: Saisir identifiants
UI -> Auth: authenticate(login, password)
Auth -> Auth: Vérifier credentials

alt Identifiants valides
    Auth -> Session: ouvrir()
    Session -> Session: Générer token
    Session --> Auth: token + dateExpiration
    Auth --> UI: token + rôle
    UI --> User: Accès accordé
else Identifiants invalides
    Auth --> UI: Erreur
    UI --> User: Message d'erreur
end
@enduml


' ============================================================
' 3. DIAGRAMME DE SÉQUENCE - Création courrier entrant
' ============================================================

@startuml
title Création d'un courrier entrant

actor "Agent / SuperAgent" as Agent
participant "Interface" as UI
participant "Courrier" as Courrier
participant "ClassificationCourrier" as Classif
participant "HistoriqueStatut" as Hist

Agent -> UI: Remplir formulaire courrier entrant
UI -> Courrier: creer()
activate Courrier
Courrier -> Courrier: id: Long\nreference: String\nobjet: String\ndateCreation: DateTime
Courrier -> Classif: proposerCategorie(texteOcrIndexe)
activate Classif
Classif --> Courrier: categorieProposee + scoreConfiance + méthode
deactivate Classif
Courrier -> Courrier: statut = "A_TRAITER"
Courrier -> Hist: ajouterHistorique(ancienStatut, nouveauStatut, commentaire)
Courrier --> UI: id + reference
deactivate Courrier
UI --> Agent: Confirmation
@enduml


' ============================================================
' 4. DIAGRAMME DE SÉQUENCE - Création courrier sortant
' ============================================================

@startuml
title Création d'un courrier sortant

actor "Agent / SuperAgent" as Agent
participant "Interface" as UI
participant "CourrierSortant" as CourrierSortant
participant "HistoriqueStatut" as Hist

Agent -> UI: Saisir destinataire, objet, contenu
UI -> CourrierSortant: creer()
activate CourrierSortant
CourrierSortant -> CourrierSortant: id: Long\nreference: String\nobjet: String\ndestinataire: String
CourrierSortant -> CourrierSortant: statut = "BROUILLON"
CourrierSortant -> Hist: ajouterHistorique(ancienStatut, nouveauStatut, commentaire)
CourrierSortant --> UI: id + reference
deactivate CourrierSortant
UI --> Agent: Confirmation
@enduml


' ============================================================
' 5. DIAGRAMME DE SÉQUENCE - Extraction OCR
' ============================================================

@startuml
title Extraction OCR

actor "Agent / SuperAgent" as Agent
participant "Interface" as UI
participant "OCRResultat" as OCR
participant "Courrier" as Courrier
participant "ClassificationCourrier" as Classif

Agent -> UI: Lancer OCR sur document scanné
UI -> OCR: extraireTexte()
activate OCR
OCR -> OCR: Traitement OCR
OCR --> UI: texteExtrait + confiance
deactivate OCR
UI --> Agent: Aperçu texte
Agent -> UI: Corriger si nécessaire
UI -> OCR: corrigerTexte(texteCorrige)
activate OCR
OCR -> OCR: texteCorrige = texteCorrige\ncorrigeManuellement = true
OCR -> Courrier: modifier(texteOcrIndexe)
activate Courrier
Courrier -> Classif: proposerCategorie(texteOcrIndexe)
Classif --> Courrier: categorieProposee + scoreConfiance
Courrier -> Courrier: categorieValidee
Courrier --> OCR: confirmation
deactivate Courrier
OCR --> UI: confirmation
deactivate OCR
UI --> Agent: OCR finalisé
@enduml


' ============================================================
' 6. DIAGRAMME DE SÉQUENCE - Mise à jour du statut
' ============================================================

@startuml
title Mise à jour du statut d'un courrier

actor "Agent / SuperAgent" as Agent
participant "Interface" as UI
participant "Courrier" as Courrier
participant "HistoriqueStatut" as Hist
participant "Notification" as Notif

Agent -> UI: Sélectionner courrier + nouveau statut
UI -> Courrier: changerStatut(idCourrier, nouveauStatut)
activate Courrier
Courrier -> Courrier: Vérifier transition valide

alt Transition valide
    Courrier -> Courrier: statut = nouveauStatut\ndateModification = DateTime
    Courrier -> Hist: ajouterHistorique(ancienStatut, nouveauStatut, commentaire)
    activate Hist
    Hist --> Courrier: id
    deactivate Hist
    Courrier -> Notif: envoyer(titre, message, canal)
    activate Notif
    Notif -> Notif: vue = false\ndateEnvoi = DateTime
    Notif --> Courrier: id
    deactivate Notif
    Courrier --> UI: Confirmation
    deactivate Courrier
    UI --> Agent: Statut mis à jour
else Transition invalide
    Courrier --> UI: Erreur
    deactivate Courrier
    UI --> Agent: Transition de statut non autorisée
end
@enduml


' ============================================================
' 7. DIAGRAMME DE SÉQUENCE - Recherche courrier
' ============================================================

@startuml
title Recherche d'un courrier

actor "Agent / SuperAgent / Lecteur" as Agent
participant "Interface" as UI
participant "Courrier" as Courrier
participant "HistoriqueStatut" as Hist

Agent -> UI: Saisir critères (référence, objet, etc.)
UI -> Courrier: rechercher(critères)
activate Courrier
Courrier -> Courrier: Filtrer par référence, objet, statut, categorieValidee
Courrier --> UI: Liste de courriers
deactivate Courrier

opt Suivre statut & historique
    UI -> Hist: rechercher(idCourrier)
    activate Hist
    Hist --> UI: ancienStatut, nouveauStatut, dateChangement, commentaire
    deactivate Hist
end

UI --> Agent: Résultats avec historique
@enduml


' ============================================================
' 8. DIAGRAMME DE SÉQUENCE - Scan document
' ============================================================

@startuml
title Scan d'un document

actor "Agent / SuperAgent" as Agent
participant "Interface" as UI
participant "ScanDocument" as Scan
participant "Piecejointe" as PJ
participant "OCRResultat" as OCR

Agent -> UI: Importer image document
UI -> Scan: capturer(imageSource)
activate Scan
Scan -> Scan: recadre = true\naméliorationLisibilité = true
Scan --> UI: Aperçu
deactivate Scan
Agent -> UI: Valider
UI -> Scan: exporterPDF() / exporterImage()
activate Scan
Scan -> PJ: sauvegarder(nomFichier, type, cheminStockage, tailleKo)
activate PJ
PJ --> Scan: id
deactivate PJ
Scan -> OCR: extraireTexte()
activate OCR
OCR --> Scan: texteExtrait + confiance + dateExtraction
deactivate OCR
Scan --> UI: Scan terminé
deactivate Scan
UI --> Agent: Confirmation + texte extrait
@enduml


' ============================================================
' 9. DIAGRAMME DE SÉQUENCE - Envoi notification
' ============================================================

@startuml
title Envoi d'une notification

actor "Système" as Systeme
participant "Notification" as Notif
participant "CanalService" as Canal
actor "Destinataire" as Dest

Systeme -> Notif: envoyer(titre, message, canal)
activate Notif
Notif -> Notif: id: Long\ndateEnvoi: DateTime\nvue: false
Notif -> Canal: envoyer(canal, message)
activate Canal
Canal --> Notif: succès/échec
deactivate Canal
Notif --> Systeme: id
deactivate Notif

Canal --> Dest: Notification reçue
@enduml


' ============================================================
' 10. DIAGRAMME DE SÉQUENCE - Gestion des utilisateurs
' ============================================================

@startuml
title Gestion des utilisateurs par l'Admin

actor "Admin" as Admin
participant "Interface" as UI
participant "AdminService" as AdminService
participant "RoleService" as Role

Admin -> UI: Accéder à l'administration
UI -> AdminService: listerUtilisateurs()
AdminService --> UI: Liste des utilisateurs
UI --> Admin: Afficher liste

alt Création utilisateur
    Admin -> UI: Saisir infos + rôle
    UI -> AdminService: creerUtilisateur(data)
    activate AdminService
    AdminService -> Role: vérifierRôle(role)
    Role --> AdminService: OK
    AdminService -> AdminService: Créer compte
    AdminService --> UI: Confirmation
    deactivate AdminService
    UI --> Admin: Utilisateur créé

else Modification utilisateur
    Admin -> UI: Modifier infos/rôle
    UI -> AdminService: modifierUtilisateur(id, data)
    activate AdminService
    AdminService --> UI: Confirmation
    deactivate AdminService
    UI --> Admin: Utilisateur modifié

else Suppression utilisateur
    Admin -> UI: Supprimer utilisateur
    UI -> AdminService: supprimerUtilisateur(id)
    activate AdminService
    AdminService --> UI: Confirmation
    deactivate AdminService
    UI --> Admin: Utilisateur supprimé
end
@enduml
